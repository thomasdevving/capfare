 "vo": [
  {
   "beat": "intro",
   "start": 0.68,
   "end": 3.09,
   "text": "Hi, my name's Thomas, and I built CapFare."
  },
  {
   "beat": "intro",
   "start": 3.64,
   "end": 6.25,
   "text": "So let's say you find a flight for 170 euros."
  },
  {
   "beat": "intro",
   "start": 6.7,
   "end": 9.53,
   "text": "A day later, the same seat costs 260 euros."
  },
  {
   "beat": "intro",
   "start": 9.92,
   "end": 12.15,
   "text": "Or you book, the next morning it's cheaper."
  },
  {
   "beat": "logo",
   "start": 13.58,
   "end": 15.44,
   "text": "CapFare locks the price of your flight,"
  },
  {
   "beat": "logo",
   "start": 15.44,
   "end": 17.64,
   "text": "wherever you book. And it runs on NEAR."
  },
  {
   "beat": "find",
   "start": 19.18,
   "end": 22.01,
   "text": "The extension recognises the flight on any booking site"
  },
  {
   "beat": "find",
   "start": 22.01,
   "end": 24.04,
   "text": "and offers to lock a maximum price."
  },
  {
   "beat": "account",
   "start": 27.78,
   "end": 30.16,
   "text": "A passkey creates a readable NEAR account."
  },
  {
   "beat": "account",
   "start": 30.16,
   "end": 33.03,
   "text": "No seed phrase, no gas, and prepaid credit."
  },
  {
   "beat": "lock",
   "start": 35.38,
   "end": 38.25,
   "text": "The premium comes from a public formula on-chain."
  },
  {
   "beat": "lock",
   "start": 38.65,
   "end": 41.38,
   "text": "The maximum payout is locked in the vault first."
  },
  {
   "beat": "choices",
   "start": 43.98,
   "end": 47.35,
   "text": "Choose the deductible and a lock of three to thirty days."
  },
  {
   "beat": "alerts",
   "start": 50.38,
   "end": 52.45,
   "text": "When the price passes your cap,"
  },
  {
   "beat": "alerts",
   "start": 52.45,
   "end": 53.78,
   "text": "you get an alert in the app,"
  },
  {
   "beat": "alerts",
   "start": 53.78,
   "end": 55.59,
   "text": "by push or by email."
  },
  {
   "beat": "claim",
   "start": 58.18,
   "end": 59.7,
   "text": "Claim with the original email."
  },
  {
   "beat": "claim",
   "start": 59.7,
   "end": 62.63,
   "text": "The payout waits for a live check of the booking"
  },
  {
   "beat": "claim",
   "start": 62.63,
   "end": 65.33,
   "text": "after a day, then it's paid from the vault."
  },
  {
   "beat": "verify",
   "start": 70.78,
   "end": 74.17,
   "text": "Only the flight, fare and price reach the chain."
  },
  {
   "beat": "verify",
   "start": 74.75,
   "end": 78.78,
   "text": "Edited emails, reused bookings and other people's bookings are refused."
  },
  {
   "beat": "drop",
   "start": 80.98,
   "end": 85.47,
   "text": "Just booked? The Drop Guarantee pays if the same flight gets cheaper."
  },
  {
   "beat": "flex",
   "start": 88.18,
   "end": 90.31,
   "text": "Route cover pays against the cheapest fare,"
  },
  {
   "beat": "flex",
   "start": 90.74,
   "end": 93.81,
   "text": "up to three days either side and from nearby airports."
  },
  {
   "beat": "travellers",
   "start": 96.08,
   "end": 98.2,
   "text": "Up to nine travellers on one policy,"
  },
  {
   "beat": "travellers",
   "start": 98.2,
   "end": 99.9,
   "text": "and a return trip bought as one."
  },
  {
   "beat": "lp",
   "start": 102.48,
   "end": 104.58,
   "text": "Liquidity providers fund two vaults."
  },
  {
   "beat": "lp",
   "start": 105.03,
   "end": 107.4,
   "text": "Every policy is fully collateralised."
  },
  {
   "beat": "near",
   "start": 109.48,
   "end": 113.41,
   "text": "So why NEAR? Gasless meta-transactions through our relayer,"
  },
  {
   "beat": "near",
   "start": 113.82,
   "end": 115.39,
   "text": "and readable named accounts."
  },
  {
   "beat": "near",
   "start": 116.06,
   "end": 121.27,
   "text": "NEP-141 tokens, async cross-contract calls that roll back on failure,"
  },
  {
   "beat": "near",
   "start": 121.7,
   "end": 125.01,
   "text": "and ed25519 checks on-chain."
  },
  {
   "beat": "near",
   "start": 125.85,
   "end": 127.54,
   "text": "All on the public explorer."
  },
  {
   "beat": "status",
   "start": 129.08,
   "end": 133.24,
   "text": "It's a testnet prototype: live contracts, demo prices."
  },
  {
   "beat": "end",
   "start": 134.68,
   "end": 137.77,
   "text": "So this is CapFare, built for the NEAR Hackathon."
  }
 ]
}