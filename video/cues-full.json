  },
  {
   "beat": "extras",
   "start": 170.955,
   "end": 173.65,
   "text": "and get an alert when it moves.",
   "cam": false
  },
  {
   "beat": "near",
   "start": 174.45,
   "end": 177.291,
   "text": "Why NEAR? Users never touch gas.",
   "cam": true
  },
  {
   "beat": "near",
   "start": 177.291,
   "end": 181.079,
   "text": "They sign meta-transactions and our relayer submits them.",
   "cam": true
  },
  {
   "beat": "near",
   "start": 181.079,
   "end": 184.868,
   "text": "Accounts are readable names, created by the relayer.",
   "cam": false
  },
  {
   "beat": "near",
   "start": 184.868,
   "end": 187.235,
   "text": "Premiums, payouts and deposits move",
   "cam": false
  },
  {
   "beat": "near",
   "start": 187.235,
   "end": 189.603,
   "text": "as NEP-141 tokens with transfer-and-call.",
   "cam": false
  },
  {
   "beat": "near",
   "start": 189.603,
   "end": 194.338,
   "text": "Every step that moves money is an async cross-contract call,",
   "cam": false
  },
  {
   "beat": "near",
   "start": 194.338,
   "end": 198.126,
   "text": "with a callback that rolls back on failure.",
   "cam": false
  },
  {
   "beat": "near",
   "start": 198.126,
   "end": 200.494,
   "text": "Price snapshots and booking attestations",
