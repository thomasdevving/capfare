  },
  {
   "beat": "lp",
   "start": 152.521,
   "end": 155.15,
   "text": "and every policy is fully collateralised.",
   "cam": false
  },
  {
   "beat": "transparency",
   "start": 155.95,
   "end": 159.714,
   "text": "Everything is public: parameters, collateral, prices and service keys.",
