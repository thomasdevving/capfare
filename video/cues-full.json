   "text": "are verified on-chain with ed25519 signatures.",
   "cam": false
  },
  {
   "beat": "near",
   "start": 203.335,
   "end": 206.65,
   "text": "And everything is on the public explorer.",
   "cam": false
  },
  {
   "beat": "status",
