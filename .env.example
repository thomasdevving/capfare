# ---- web (web/.env.local) ----
CAPFARE_NETWORK=testnet            # testnet | sandbox (mainnet is refused)
NEAR_RPC_URL=https://rpc.testnet.near.org
REGISTRY_ID=registry.<your-account>.testnet
ATTESTATION_ID=att.<your-account>.testnet
CAP_VAULT_ID=cap.<your-account>.testnet
DROP_VAULT_ID=drop.<your-account>.testnet
TOKEN_ID=usdc.<your-account>.testnet
ORACLE_URL=http://localhost:8081
VERIFIER_URL=http://localhost:8082
RELAYER_URL=http://localhost:8083
CAPFARE_DEMO=true                  # enables demo-only routes (fixtures, scripted prices)
RAMP_ACCOUNT_ID=<ramp-account>.testnet
RAMP_PRIVATE_KEY=                  # testnet only; never commit
ONECLICK_API_KEY=                  # optional, NEAR Intents 1Click (dry quotes work without)
SITE_URL=https://your-deployment.example
EXTENSION_URL=                     # link for "Add to Chrome"
GITHUB_URL=https://github.com/thomasdevving/capfare

# ---- relayer ----
NEAR_NETWORK=testnet
RELAYER_ACCOUNT_ID=<your-account>.testnet
RELAYER_PRIVATE_KEY=               # never commit
TOKEN_IS_MOCK=true
NEW_ACCOUNT_YOCTO=50000000000000000000000

# ---- TEE services ----
CAPFARE_DEPLOYMENT=demo            # dev | demo | test | production
CAPFARE_KEY_PROVIDER=dev           # dev | dstack (inside a Phala/dstack TDX CVM)
ORACLE_DEV_SEED=                   # 32-byte hex, dev/demo only
VERIFIER_DEV_SEED=                 # 32-byte hex, dev/demo only
RELAYER_URL=http://localhost:8083

# ---- deploy script (scripts/src/deploy.ts) ----
NETWORK=testnet
RPC_URL=https://rpc.testnet.near.org
ROOT_ACCOUNT=<your-account>.testnet
ROOT_KEY=                          # ed25519:... never commit
PARAMS_FILE=backtest/output/demo_params.json
DEMO=true
