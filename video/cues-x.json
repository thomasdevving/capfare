 "vo": [
  {
   "beat": "intro",
   "start": 0.45,
   "end": 2.696,
   "text": "You find a flight for 170 euros.",
   "cam": true
  },
  {
   "beat": "intro",
   "start": 2.696,
   "end": 5.263,
   "text": "A day later, the same seat costs 260.",
   "cam": true
  },
  {
   "beat": "intro",
   "start": 5.263,
   "end": 8.15,
   "text": "Or you book, and the next morning it's cheaper.",
   "cam": true
  },
  {
   "beat": "logo",
   "start": 8.95,
   "end": 11.95,
   "text": "CapFare locks the price of your flight, wherever you book.",
   "cam": false
  },
  {
   "beat": "logo",
   "start": 11.95,
   "end": 13.15,
   "text": "It runs on NEAR.",
   "cam": false
  },
  {
   "beat": "find",
   "start": 13.95,
   "end": 16.275,
   "text": "The extension recognises the flight on",
   "cam": false
  },
  {
   "beat": "find",
   "start": 16.275,
   "end": 20.15,
   "text": "any booking site and offers to lock a maximum price.",
   "cam": false
  },
  {
   "beat": "account",
   "start": 20.95,
   "end": 24.05,
   "text": "A passkey creates a readable NEAR account.",
   "cam": false
  },
  {
   "beat": "account",
   "start": 24.05,
   "end": 27.15,
   "text": "No seed phrase, no gas, prepaid credit.",
   "cam": false
  },
  {
   "beat": "lock",
   "start": 27.95,
   "end": 31.574,
   "text": "The premium comes from a public formula on-chain.",
   "cam": false
  },
  {
   "beat": "lock",
   "start": 31.574,
   "end": 35.65,
   "text": "The maximum payout is locked in the vault first.",
   "cam": false
  },
  {
   "beat": "choices",
   "start": 36.45,
   "end": 42.15,
   "text": "Choose the deductible and a lock of three to thirty days.",
   "cam": false
  },
  {
   "beat": "alerts",
   "start": 42.95,
   "end": 45.603,
   "text": "When the demo price passes your cap,",
   "cam": false
  },
  {
   "beat": "alerts",
   "start": 45.603,
   "end": 48.255,
   "text": "you get an alert in the app,",
   "cam": false
  },
  {
   "beat": "alerts",
   "start": 48.255,
   "end": 50.15,
   "text": "by push or by email.",
   "cam": false
  },
  {
   "beat": "claim",
   "start": 50.95,
   "end": 53.283,
   "text": "Claim with the original email.",
   "cam": false
  },
  {
   "beat": "claim",
   "start": 53.283,
   "end": 56.083,
   "text": "The payout waits for a live",
   "cam": false
  },
  {
   "beat": "claim",
   "start": 56.083,
   "end": 59.35,
   "text": "check of the booking after a day,",
   "cam": false
  },
  {
   "beat": "claim",
   "start": 59.35,
   "end": 62.15,
   "text": "then it's paid from the vault.",
   "cam": false
  },
  {
   "beat": "verify",
   "start": 62.95,
   "end": 66.834,
   "text": "Only the flight, fare and price reach the chain.",
   "cam": false
  },
  {
   "beat": "verify",
   "start": 66.834,
   "end": 71.15,
   "text": "Edited emails, reused bookings and other people's bookings are refused.",
   "cam": false
  },
  {
   "beat": "drop",
   "start": 71.95,
   "end": 75.05,
   "text": "Just booked? The Drop Guarantee pays",
   "cam": false
  },
  {
   "beat": "drop",
   "start": 75.05,
   "end": 78.15,
   "text": "if the same flight gets cheaper.",
   "cam": false
  },
  {
   "beat": "flex",
   "start": 78.95,
   "end": 81.915,
   "text": "Route cover pays against the cheapest fare,",
   "cam": false
  },
  {
   "beat": "flex",
   "start": 81.915,
   "end": 86.15,
   "text": "up to three days either side and from nearby airports.",
   "cam": false
  },
  {
   "beat": "travellers",
   "start": 86.95,
   "end": 90.05,
   "text": "Up to nine travellers on one policy,",
   "cam": false
  },
  {
   "beat": "travellers",
   "start": 90.05,
   "end": 93.15,
   "text": "and a return trip bought as one.",
   "cam": false
  },
  {
   "beat": "lp",
   "start": 93.95,
   "end": 97.55,
   "text": "Liquidity providers fund two vaults.",
   "cam": false
  },
  {
   "beat": "lp",
   "start": 97.55,
   "end": 101.15,
   "text": "Every policy is fully collateralised.",
   "cam": false
  },
  {
   "beat": "near",
   "start": 101.95,
   "end": 106.897,
   "text": "Why NEAR? Gasless meta-transactions through our relayer,",
   "cam": true
  },
  {
   "beat": "near",
   "start": 106.897,
   "end": 109.723,
   "text": "and readable named accounts.",
   "cam": true
  },
  {
   "beat": "near",
   "start": 109.723,
   "end": 116.79,
   "text": "NEP-141 tokens, async cross-contract calls that roll back on failure,",
   "cam": false
  },
  {
   "beat": "near",
   "start": 116.79,
   "end": 119.617,
   "text": "and ed25519 checks on-chain.",
   "cam": false
  },
  {
   "beat": "near",
   "start": 119.617,
   "end": 123.15,
   "text": "All on the public explorer.",
   "cam": false
  },
  {
   "beat": "status",
   "start": 123.95,
   "end": 128.064,
   "text": "It's a testnet prototype: live contracts, demo prices,",
