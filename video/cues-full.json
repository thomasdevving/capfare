  },
  {
   "beat": "transparency",
   "start": 163.059,
   "end": 165.15,
   "text": "and the page says so.",
   "cam": false
  },
  {
   "beat": "extras",
   "start": 165.95,
   "end": 168.645,
   "text": "Paste a link from any booking site,",
