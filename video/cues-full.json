 "vo": [
  {
   "beat": "intro",
   "start": 0.45,
   "end": 2.988,
   "text": "You find a flight for 170 euros.",
   "cam": true
  },
  {
   "beat": "intro",
   "start": 2.988,
   "end": 5.888,
   "text": "A day later, the same seat costs 260.",
   "cam": true
  },
  {
   "beat": "intro",
   "start": 5.888,
   "end": 9.15,
   "text": "Or you book, and the next morning it's cheaper.",
   "cam": true
  },
  {
   "beat": "logo",
   "start": 9.95,
   "end": 13.307,
   "text": "CapFare locks the price of your flight, wherever you book.",
   "cam": false
  },
  {
   "beat": "logo",
   "start": 13.307,
   "end": 14.65,
   "text": "It runs on NEAR.",
   "cam": false
  },
  {
   "beat": "find",
   "start": 15.45,
   "end": 19.177,
   "text": "The CapFare extension recognises the flight on any booking site.",
   "cam": false
  },
  {
   "beat": "find",
   "start": 19.177,
   "end": 21.041,
   "text": "Here, on our demo site,",
   "cam": false
  },
  {
   "beat": "find",
   "start": 21.041,
   "end": 23.65,
   "text": "it offers to lock a maximum price.",
   "cam": false
  },
  {
   "beat": "account",
   "start": 24.45,
   "end": 26.345,
   "text": "No wallet, no seed phrase.",
   "cam": false
  },
  {
   "beat": "account",
   "start": 26.345,
   "end": 28.997,
   "text": "A passkey creates a readable NEAR account,",
   "cam": false
  },
  {
   "beat": "account",
   "start": 28.997,
   "end": 31.65,
   "text": "and the relayer pays every gas fee.",
   "cam": false
  },
  {
   "beat": "credit",
   "start": 32.45,
   "end": 34.617,
   "text": "Premiums come from prepaid credit.",
   "cam": false
  },
  {
   "beat": "credit",
   "start": 34.617,
   "end": 37.65,
   "text": "The iDEAL top-up is simulated on testnet.",
   "cam": false
  },
  {
   "beat": "lock",
   "start": 38.45,
   "end": 42.859,
   "text": "The premium comes from a public formula on the contract.",
   "cam": false
  },
  {
   "beat": "lock",
   "start": 42.859,
   "end": 45.505,
   "text": "Buying locks the full maximum payout",
   "cam": false
  },
  {
   "beat": "lock",
   "start": 45.505,
   "end": 48.15,
   "text": "in the vault before you pay.",
   "cam": false
  },
  {
   "beat": "choices",
   "start": 48.95,
   "end": 53.266,
   "text": "You choose the deductible and how long the lock lasts,",
   "cam": false
  },
  {
   "beat": "choices",
   "start": 53.266,
   "end": 57.15,
   "text": "three to thirty days. A higher deductible costs less.",
   "cam": false
  },
  {
   "beat": "alerts",
   "start": 57.95,
   "end": 61.088,
   "text": "Prices here come from a scripted demo source.",
   "cam": false
  },
  {
   "beat": "alerts",
   "start": 61.088,
   "end": 63.442,
   "text": "When the price passes your cap,",
   "cam": false
  },
  {
   "beat": "alerts",
   "start": 63.442,
   "end": 66.188,
   "text": "you get an alert in the app,",
   "cam": false
  },
  {
   "beat": "alerts",
   "start": 66.188,
   "end": 68.15,
   "text": "by push or by email.",
   "cam": false
  },
  {
   "beat": "claim",
   "start": 68.95,
   "end": 72.056,
   "text": "Book anywhere, then claim with the original email.",
   "cam": false
  },
  {
   "beat": "claim",
   "start": 72.056,
   "end": 75.55,
   "text": "Bookings can often be cancelled free for a day,",
   "cam": false
  },
  {
   "beat": "claim",
   "start": 75.55,
   "end": 79.821,
   "text": "so the payout waits for a live check of the booking.",
   "cam": false
  },
  {
   "beat": "claim",
   "start": 79.821,
   "end": 82.15,
   "text": "Then it's paid from the vault.",
   "cam": false
  },
  {
   "beat": "verify",
   "start": 82.95,
   "end": 87.144,
   "text": "Bookings are checked by a verifier built for a hardware enclave.",
   "cam": false
  },
  {
   "beat": "verify",
   "start": 87.144,
   "end": 90.575,
   "text": "Only the flight, fare and price reach the chain.",
   "cam": false
  },
  {
   "beat": "verify",
   "start": 90.575,
   "end": 92.1,
   "text": "Edited or forwarded emails,",
   "cam": false
  },
  {
   "beat": "verify",
   "start": 92.1,
   "end": 95.15,
   "text": "reused bookings and someone else's booking are refused.",
   "cam": false
  },
  {
   "beat": "drop",
   "start": 95.95,
   "end": 99.197,
   "text": "Just booked? The Drop Guarantee pays",
   "cam": false
  },
  {
   "beat": "drop",
   "start": 99.197,
   "end": 105.15,
   "text": "the difference if the same flight gets cheaper during its window.",
   "cam": false
  },
  {
   "beat": "flex",
   "start": 105.95,
   "end": 108.304,
   "text": "Not sure which flight or day?",
   "cam": false
  },
  {
   "beat": "flex",
   "start": 108.304,
   "end": 112.227,
   "text": "Route cover pays against the cheapest fare on the route,",
   "cam": false
  },
  {
   "beat": "flex",
   "start": 112.227,
   "end": 116.15,
   "text": "up to three days either side, and from nearby airports.",
   "cam": false
  },
  {
   "beat": "travellers",
   "start": 116.95,
   "end": 119.995,
   "text": "One policy covers up to nine travellers.",
   "cam": false
  },
  {
   "beat": "travellers",
   "start": 119.995,
   "end": 123.04,
   "text": "A return trip is bought as one,",
   "cam": false
  },
  {
   "beat": "travellers",
   "start": 123.04,
   "end": 125.65,
   "text": "and one booking claims both flights.",
   "cam": false
  },
  {
   "beat": "renew",
   "start": 126.45,
   "end": 130.571,
   "text": "Refundable tickets get their final check just before departure.",
   "cam": false
  },
  {
   "beat": "renew",
   "start": 130.571,
   "end": 135.15,
   "text": "And a Price Cap can be renewed without a gap.",
   "cam": false
  },
  {
   "beat": "payout",
   "start": 135.95,
   "end": 137.867,
   "text": "Payouts arrive as test USDC.",
   "cam": false
  },
  {
   "beat": "payout",
   "start": 137.867,
   "end": 140.167,
   "text": "Withdraw them, send them to a",
   "cam": false
  },
  {
   "beat": "payout",
   "start": 140.167,
   "end": 142.467,
   "text": "bank account through a simulated ramp,",
   "cam": false
  },
  {
   "beat": "payout",
   "start": 142.467,
   "end": 145.15,
   "text": "or quote another asset with NEAR Intents.",
   "cam": false
  },
  {
   "beat": "lp",
   "start": 145.95,
   "end": 149.893,
   "text": "Liquidity providers fund two separate vaults, one per product.",
